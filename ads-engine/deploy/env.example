# /opt/ihor/shur-ads/env — права 600. Здесь только ИМЕНА; значения в репозиторий не кладём.
# Пустое значение = соответствующая часть работает «сухо».

# Приём лидов: общий секрет с сайтом (на Vercel тот же LEDGER_HMAC_SECRET, адрес — LEDGER_URL).
# install.sh генерирует его сам и не печатает.
LEDGER_HMAC_SECRET=

# Служебный бот (ОТДЕЛЬНЫЙ от бота заявок). Без токена — сухой режим: data/telegram-outbox.jsonl.
SHUR_OPS_BOT_TOKEN=
SHUR_OPS_CHAT_ID=

# Meta Marketing API, только чтение (ads_read). Без пары — работа на фикстурах.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Conversions API: выключен, пока META_CAPI_ENABLED не равен 1.
META_DATASET_ID=
META_CAPI_ENABLED=
META_CAPI_TEST_EVENT_CODE=

# Необязательно: observe | approve | auto (перекрывает mode из limits.json).
SHUR_ADS_RULES_MODE=
