# Журнал заявок SHUR-SHUR наружу. Лежит в /etc/caddy/shur/shur-ads.caddy,
# подключён одной строкой `import shur/*.caddy` в /etc/caddy/Caddyfile.
# Ставится и меняется по OWNER-RULES п.21: копия Caddyfile, validate, только reload,
# сверка кодов всех хостов до и после, откат при любом отличии.
# Наружу открыты только POST /v1/leads и POST /v1/leads/<uuid>/delivered (договор v1.1);
# /healthz и всё остальное — 404. Подпись HMAC проверяет сам ads-engine.
shur-ads.central-aparts.store {
	@leads {
		method POST
		path_regexp ^/v1/leads(/[0-9a-fA-F-]{36}/delivered)?$
	}
	handle @leads {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:8014 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond 404
	}
}
