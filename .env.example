# Имена переменных сайта (Vercel, production). Значения сюда НЕ кладём.

# Заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEDGER_URL=
LEDGER_HMAC_SECRET=
NEXT_PUBLIC_SITE_URL=

# Кабинет статистики (/cabinet)
# Подпись снимков и ссылок установки пароля с ace-main. Тот же ключ лежит в
# /opt/ihor/shur-ads/env; в Vercel его заводит сценарий «Cabinet setup».
CABINET_HMAC_SECRET=
# Приватное хранилище Vercel Blob (снимок + хэш пароля). Vercel заводит его
# сам, когда хранилище подключено к проекту.
BLOB_READ_WRITE_TOKEN=
