# Имена переменных сайта (Vercel, production). Значения сюда НЕ кладём.

# Заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEDGER_URL=
LEDGER_HMAC_SECRET=
NEXT_PUBLIC_SITE_URL=

# Кабинет статистики (/cabinet)
# Подпись снимков и ссылок установки пароля с ace-main. Тот же ключ лежит в
# /opt/ihor/shur-ads/env; в Vercel его заводит сценарий «Cabinet setup».
CABINET_HMAC_SECRET=
# Шифрование ключа Meta, который хозяйка передаёт в кабинете (base64, 32 байта).
# Тот же ключ — в /opt/ihor/shur-ads/env; в Vercel заводит «Cabinet setup».
CABINET_META_KEY=
# Приватное хранилище Vercel Blob (снимок + хэш пароля). Vercel заводит его
# сам, когда хранилище подключено к проекту.
BLOB_READ_WRITE_TOKEN=

# Подписка клиентов на бота (/client/<id>), эквайринг monobank.
# Без MONO_TOKEN кнопки оплаты нет и ничего не списывается («Оплата скоро»).
# Те же значения — в /opt/ihor/shur-ads/env; в Vercel заводит «Billing setup».
# Боевой токен — из web.monobank.ua.
MONO_TOKEN=
# Тестовый токен — из api.monobank.ua; работает только для клиентов «тест».
MONO_TEST_TOKEN=
# Необязательно: цена в целых гривнах, если подписка в евро не принимается.
MONO_PRICE_UAH=
